    <!-- Onboarding -->
    <string name="onboarding_title_1">நொடிகளில் புகார் அளிக்கவும்</string>
    <string name="onboarding_desc_1">தானியங்கி ஜிபிஎஸ் இருப்பிடத்துடன் குழிகள், குப்பை அல்லது தெருவிளக்கு பழுதினை புகைப்படம் எடுக்கவும்.</string>
    <string name="onboarding_title_2">ஒவ்வொரு படியையும் பின்தொடரவும்</string>
    <string name="onboarding_desc_2">புகார் சமர்ப்பிப்பு முதல் அதிகாரி நியமனம் மற்றும் இறுதி தீர்வு வரை நேரலை புதுப்பிப்புகளைப் பார்க்கவும்.</string>
    <string name="onboarding_title_3">வெளிப்படையான தீர்வு</string>
    <string name="onboarding_desc_3">ஐநா எஸ்டிஜி 11 (நிலையான நகரங்கள்) மற்றும் எஸ்டிஜி 16 (வலுவான நிறுவனங்கள்) இலக்குகள்.</string>
